#Railway public proxy host and port (from MYSQL_PUBLIC_URL)
MYSQL_HOST=
MYSQL_PORT=
MYSQL_USER=blog_app
MYSQL_PASSWORD=
MYSQL_DB=blog_secure
MYSQL_CHARSET=utf8mb4

#Make one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

#false only while running ZAP or the tests
RATELIMIT_ENABLED=true


ADMIN_EMAIL=
ADMIN_PASSWORD=


INSECURE_MYSQL_USER=blog_insecure_app
INSECURE_MYSQL_PASSWORD=
INSECURE_MYSQL_DB=blog_insecure