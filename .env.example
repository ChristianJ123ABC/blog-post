#Railway public proxy host and port (from MYSQL_PUBLIC_URL)
MYSQL_HOST=
MYSQL_PORT=
MYSQL_USER=blog_app
MYSQL_PASSWORD=
MYSQL_DB=blog_secure
MYSQL_CHARSET=utf8mb4

#Make one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

#false only while running ZAP or the tests (lowercase) then run docker compose up -d --build --force-recreate run this when changing each
#Set it to true for TC-20, rerun docker, then run pytest/tests/ -k tc20, then set it back to false
RATELIMIT_ENABLED=false


ADMIN_EMAIL=
ADMIN_PASSWORD=


INSECURE_MYSQL_USER=blog_insecure_app
INSECURE_MYSQL_PASSWORD=
INSECURE_MYSQL_DB=blog_insecure